    "import pandas as pd\n",
    "import yfinance as yf\n",
    "import pandas_datareader.data as web\n",
    "from datetime import datetime\n",
    "\n",
    "# 1. Definimos la ventana de tiempo (Últimos 5 años)\n",
    "start_date = \"2021-01-01\"\n",
    "end_date = datetime.now().strftime('%Y-%m-%d')\n",
    "\n",
    "print(\" Iniciando extracción de datos (Solución definitiva para MultiIndex 2026) \")\n",
    "\n",
    "try:\n",
    "    # 2. Extracción Individual de Yahoo Finance\n",
    "    print(\"Descargando fletes marítimos (BDRY)...\")\n",
    "    bdry_raw = yf.download('BDRY', start=start_date, end=end_date)\n",
    "    \n",
    "    print(\"Descargando petróleo (Brent)...\")\n",
    "    brent_raw = yf.download('CL=F', start=start_date, end=end_date)\n",
    "    \n",
    "    # Aplanamos el MultiIndex y extraemos 'Close'\n",
    "    # Seleccionamos la columna ('Close', 'BDRY') usando la tupla del MultiIndex\n",
    "    serie_bdry = bdry_raw[('Close', 'BDRY')].copy()\n",
    "    serie_brent = brent_raw[('Close', 'CL=F')].copy()\n",
    "    \n",
    "    # Convertimos a DataFrames limpios con columnas simples de un solo nivel\n",
    "    df_bdry = pd.DataFrame({'Fletes_BdryETF': serie_bdry})\n",
    "    df_brent = pd.DataFrame({'Petroleo_Brent': serie_brent})\n",
    "    \n",
    "    # Unimos los datos financieros\n",
    "    df_finance = df_bdry.join(df_brent, how='inner')\n",
    "    print(\"Datos de Yahoo Finance corregidos y consolidados correctamente\")\n",
    "\n",
    "    # 3. Extracción de Datos Macroeconómicos vía FRED\n",
    "    print(\"Descargando datos macroeconómicos de FRED...\")\n",
    "    tickers_macro = {'Inflacion_US': 'CPIAUCSL', 'Tasa_Fed': 'FEDFUNDS'}\n",
    "    df_macro = web.DataReader(list(tickers_macro.values()), 'fred', start_date, end=end_date)\n",
    "    print(\"Datos Macroeconómicos de FRED descargados correctamente\")\n",
    "\n",
    "    # Unimos todas las fuentes\n",
    "    print(\"\\n Consolidando y uniendo datasets globales \")\n",
    "    \n",
    "    # Nos aseguramos que los índices tengan formato Datetime limpio\n",
    "    df_finance.index = pd.to_datetime(df_finance.index)\n",
    "    df_macro.index = pd.to_datetime(df_macro.index)\n",
    "\n",
    "    # Aplicamos Left join tomando como base los días de operación de los mercados financieros\n",
    "    df_consolidado = df_finance.join(df_macro, how='left')\n",
    "\n",
    "    # Aplicamos Forward fill para propagar los datos macro mensuales en los días diarios\n",
    "    df_consolidado = df_consolidado.ffill()\n",
    "\n",
    "    # Limpiamos remanentes iniciales si los hay\n",
    "    df_consolidado.dropna(inplace=True)\n",
    "\n",
    "    print(f\"\\n ¡Unión exitosa! El dataset final contiene {df_consolidado.shape[0]} registros y {df_consolidado.shape[1]} variables.\")\n",
    "    print(\"\\nPrimeras 5 filas del dataset consolidado:\")\n",
    "    print(df_consolidado.head())\n",
    "\n",
    "    # Guardamos la copia local \n",
    "    df_consolidado.to_csv(\"Dataset_SupplyChain_Macro.csv\")\n",
    "    print(\"\\n[INFO] Archivo 'Dataset_SupplyChain_Macro.csv' guardado con éxito.\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"\\n❌ Ocurrió un error en la recolección o unión: {e}\")"
   ]
